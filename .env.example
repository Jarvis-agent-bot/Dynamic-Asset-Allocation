# Supabase Auth (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Service role key: server-side only, for admin operations (bootstrap, etc.)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
# DAA_DB_URL=postgres://user:password@localhost:5432/daa

# LLM (DeepSeek / OpenAI-compatible)
# DAA_LLM_API_KEY 优先；也兼容 OPENAI_API_KEY
DAA_LLM_API_KEY=your_deepseek_api_key_here
DAA_LLM_ENDPOINT=https://api.deepseek.com/v1/chat/completions
DAA_LLM_MODEL=deepseek-chat

# Embedding provider — 用于 Agent 记忆语义检索（pgvector 1024 维 BGE-M3）
# 选项 1：本地 Ollama sidecar（docker-compose 自带，推荐；无需 API key）
#   DAA_EMBEDDING_PROVIDER=ollama
#   # endpoint/model 默认 http://ollama:11434/v1/embeddings / bge-m3，通常无需覆盖
# 选项 2：SiliconFlow 云 API（有免费额度，注册 https://cloud.siliconflow.cn/）
#   DAA_EMBEDDING_PROVIDER=siliconflow
#   DAA_EMBEDDING_API_KEY=sk-xxx
# 选项 3：OpenAI 兼容（text-embedding-3-small，支持 dimensions=1024）
#   DAA_EMBEDDING_PROVIDER=openai
#   DAA_EMBEDDING_API_KEY=sk-xxx
# DAA_EMBEDDING_ENDPOINT=
# DAA_EMBEDDING_MODEL=

# News data sources (US market — 优先级: Alpaca → Finnhub → Yahoo RSS)
# Alpaca: 免费 REST + WebSocket 实时推送 (Benzinga 源)；注册 https://app.alpaca.markets/signup
# ALPACA_API_KEY_ID=your_alpaca_key_id
# ALPACA_API_SECRET_KEY=your_alpaca_secret
# Finnhub: 备选 REST
# FINNHUB_API_KEY=your_finnhub_key

# Optional Telegram notification
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
# TELEGRAM_ALLOWLIST=7567255792,7567255792:123456789
# 说明：
# - TELEGRAM_CHAT_ID 用于出站通知默认接收人
# - TELEGRAM_ALLOWLIST 用于限制谁可以通过 webhook 与助手对话；支持 chatId、userId、chatId:userId
# - 如需 Telegram 对话助手，还需要把 Bot webhook 指到 /api/daa/chat/telegram/webhook

# Optional Feishu (Lark) notification
# FEISHU_WEBHOOK_URL=
#
# Secrets encryption key (optional)
# Used to encrypt API keys stored in DB via the Settings → Credentials UI.
# If not set, a key is automatically derived from DAA_DB_URL.
# DAA_SECRETS_ENCRYPTION_KEY=your-random-string

# Admin API tokens (optional, for admin-only endpoints)
# DAA_ADMIN_EDITOR_TOKEN=your-editor-token
# DAA_ADMIN_VIEWER_TOKEN=your-viewer-token

# Cron authentication token (required for /api/daa/cron/* routes)
# DAA_CRON_TOKEN=your-cron-secret

# Secondary database URL (fallback if DAA_DB_URL not set)
# DATABASE_URL=postgres://user:password@localhost:5432/daa

# Danjuan fund data source (optional, for hedge fund holdings tracking)
# DAA_HF_DANJUAN_ENABLED=true
# DAA_HF_DANJUAN_FUNDS=006533,100055
# DAA_HF_DANJUAN_CONCURRENCY=4

# Vercel deployment URL (auto-set by Vercel, used for backfill origin)
# VERCEL_URL=your-project.vercel.app
