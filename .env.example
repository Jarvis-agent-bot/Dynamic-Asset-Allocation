# Supabase Auth (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Service role key: server-side only, for admin operations (bootstrap, etc.)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
# DAA_DB_URL=postgres://user:password@localhost:5432/daa

# LLM (Codex/OpenAI-compatible)
OPENAI_API_KEY=your_api_key_here
DAA_LLM_ENDPOINT=https://api.openai.com/v1/responses
DAA_LLM_MODEL=gpt-5-codex

# Optional legacy provider
# PACKYCODE_API_KEY=
# PACKYCODE_ENDPOINT=

# Optional email notification (Resend)
# RESEND_API_KEY=
# DAA_EMAIL_FROM="DAA Bot <onboarding@resend.dev>"

# Optional Telegram notification
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional Feishu (Lark) notification
# FEISHU_WEBHOOK_URL=
